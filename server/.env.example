PORT=3009
MONGODB_URI=mongodb://127.0.0.1:27017/pakmedrecord
# Any long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# AI assistant (optional; disabled without a key).
# Provider: "mistral" (default, free "Experiment" plan at https://console.mistral.ai) or "anthropic" (Claude, paid)
AI_PROVIDER=mistral
MISTRAL_API_KEY=
# ANTHROPIC_API_KEY=
# Model override (defaults: ministral-14b-latest / claude-opus-5-5)
# AI_MODEL=
# Public URL of the frontend (used in verification email links)
APP_URL=http://localhost:5173
# Email verification via the Gmail API (Google Cloud OAuth client + refresh token with gmail.send scope).
# Without these, new accounts are verified automatically.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
# "Sign in with Google" via Firebase Auth (Firebase project ID; leave empty to hide the button)
FIREBASE_PROJECT_ID=
