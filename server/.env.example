PORT=3009
MONGODB_URI=mongodb://127.0.0.1:27017/pakmedrecord
# Any long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# AI assistant (optional; disabled without a key).
# Provider: "mistral" (default, free "Experiment" plan at https://console.mistral.ai) or "anthropic" (Claude, paid)
AI_PROVIDER=mistral
MISTRAL_API_KEY=
# ANTHROPIC_API_KEY=
# Model override (defaults: ministral-14b-latest / claude-opus-5-5)
# AI_MODEL=
# Public URL of the frontend (used in verification email links)
APP_URL=http://localhost:5173
# Email verification via the Gmail API (Google Cloud OAuth client + refresh token with gmail.send scope).
# Without these, new accounts are verified automatically.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
# "Sign in with Google" via Firebase Auth (Firebase project ID; leave empty to hide the button)
FIREBASE_PROJECT_ID=
# Public URL of this API (Safepay sends patients back here after paying)
# API_URL=https://pakmedrecord-api.vercel.app
# Extra allowed browser origins for CORS, comma-separated (APP_URL is always allowed)
# CORS_ORIGINS=

# First admin account: created on first sign-in at /admin/signin if no admin exists yet
# (or run: npm run create-admin -- you@example.com "Your Name" a-long-password)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Daily reminder job (Vercel Cron calls /cron/daily with this as a Bearer token)
CRON_SECRET=

# Reminders by WhatsApp (Meta WhatsApp Cloud API) and SMS (Twilio). Optional.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE=          # approved template with one body parameter
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# Online consultation fees go straight to each clinic's (or solo doctor's) own Safepay merchant
# account, which they connect in the app. Their secret keys are encrypted with this key
# (64 hex chars, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"):
PAYMENT_SECRETS_KEY=
# Simulated checkout for demos (no money moves)
PAYMENTS_TEST_MODE=

# Video visits: optional TURN relay for networks that block direct connections
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=
